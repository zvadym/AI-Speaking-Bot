{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "API",
      "command": "${workspaceFolder}/scripts/dev-api.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Mini-app",
      "command": "${workspaceFolder}/scripts/dev-miniapp.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "n8n (docker)",
      "command": "docker compose --env-file deploy/.env.dev -f deploy/docker-compose.yml up -d --force-recreate",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "All",
      "configurations": ["API", "Mini-app", "n8n (docker)"]
    }
  ]
}
