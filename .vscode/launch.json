{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "API",
      "command": "${workspaceFolder}/scripts/dev-api.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Mini-app",
      "command": "${workspaceFolder}/scripts/dev-miniapp.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Worker",
      "command": "cd apps/api && npm run worker:dev",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "All",
      "configurations": ["API", "Worker", "Mini-app"]
    }
  ]
}
