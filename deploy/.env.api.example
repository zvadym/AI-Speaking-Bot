API_PORT=3000
API_BASE_URL=https://learn-language-api.notarobot.dev
WEBAPP_URL=https://learn-language-app.notarobot.dev
# Optional: where Stripe (Checkout + Billing Portal) sends the user back after payment.
# Useful for Telegram internal links like: https://t.me/YOUR_BOT_USERNAME/menu
WEBAPP_RETURN_URL=
CORS_ORIGINS=https://learn-language-app.notarobot.dev

DATABASE_URL=postgres://languagebot:YOUR_PASSWORD@YOUR_HOST:5432/languagebot
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Telegram bot tokens are configured in bot config files (deploy/bots/*.json)
# The bots directory is mounted into the API container as a read-only volume
# Each bot config file must contain a "telegram_bot_token" field
TELEGRAM_INITDATA_MAX_AGE=86400

STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PORTAL_CONFIG_ID=bpc_xxx
STRIPE_BILLING_PRODUCT_ID=prod_xxx

JWT_SECRET=change_me_long_random
INTERNAL_API_SECRET=REDACTED_SECRET
BROADCAST_MAX_RECIPIENTS=2000
BROADCAST_PROCESS_BATCH_SIZE=100
BROADCAST_PER_MESSAGE_DELAY_MS=35
BROADCAST_SEND_CONCURRENCY=5
# Optional: chat ID to upload broadcast media to.
BROADCAST_MEDIA_CHAT_ID=-1000000000000
ONBOARDING_COMPLETE_IDLE_MINUTES=2
ONBOARDING_COMPLETE_SCAN_LIMIT=500
# Optional: limit scheduled onboarding scans to specific Telegram chat IDs during testing.
# Example: SCHEDULED_TASKS_TEST_CHAT_IDS=123456789,987654321
SCHEDULED_TASKS_TEST_CHAT_IDS=
# UTC hours for automatic idiom reminders. Defaults to 07:15 and 17:15 UTC.
IDIOM_PRACTICE_SEND_HOURS_UTC=7,17
IDIOM_PRACTICE_SEND_MINUTE_UTC=15
# Legacy single-hour fallback; ignored when IDIOM_PRACTICE_SEND_HOURS_UTC is set.
IDIOM_PRACTICE_SEND_HOUR_UTC=
JOB_RETRY_MAX_ATTEMPTS=5
# Optional JSON map of bot keys to routes handled by the TypeScript bot runtime.
# Keep unset or use {} to leave the runtime dark.
# BOT_RUNTIME_ROUTE_FLAGS_JSON={"uk-en":["command.stats"]}
BOT_RUNTIME_ROUTE_FLAGS_JSON=
# Comma-separated bot keys for rotating progress messages, or * for all bots.
BOT_PROGRESS_ENABLED_BOT_KEYS=
# Comma-separated bot keys for immediate Telegram typing status, or * for all bots.
BOT_IMMEDIATE_ACK_ENABLED_BOT_KEYS=
# Comma-separated bot keys that enroll new users into interactive onboarding v2, or * for all bots.
BOT_ONBOARDING_V2_ENABLED_BOT_KEYS=
BOT_RUNTIME_MODEL=gpt-5.4
BOT_RUNTIME_REASONING_EFFORT=
# Optional separate model for translation, hints, and vocabulary.
# Defaults to BOT_RUNTIME_MODEL for a behavior-preserving rollout.
BOT_SUPPORT_MODEL=
BOT_SUPPORT_REASONING_EFFORT=
# Optional per-bot canary overrides. Unknown bot keys and fields fail startup.
# Example: {"uk-de":{"conversationModel":"gpt-5.6-luna","conversationReasoningEffort":"none"}}
BOT_MODEL_POLICY_JSON=
BOT_TRANSCRIPTION_MODEL=gpt-4o-transcribe
BOT_TTS_MODEL=gpt-4o-mini-tts

# Internal admin dashboard (API-side password gate for /admin/metrics/*)
ADMIN_DASHBOARD_PASSWORD=change_me_admin_password

# Optional: Discord webhook URL to send events to.
DISCORD_EVENTS_WEBHOOK_URL=
