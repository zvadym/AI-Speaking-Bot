# Copy outside the checkout. VITE_* values are public browser build inputs.
# Never put Telegram, OpenAI, Stripe secret keys or database credentials here.
VITE_API_BASE=https://learn-language-api.notarobot.dev
VITE_POSTHOG_KEY=
# Optional: PostHog instance URL (cloud default shown). For EU cloud use https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Optional: keep Stripe checkout inside the mini-app (Embedded Checkout).
# Requires a Stripe publishable key (pk_...).
VITE_STRIPE_EMBEDDED_CHECKOUT=false
VITE_STRIPE_PUBLISHABLE_KEY=
# Optional: always show in-app debug panel and collect flow logs
VITE_DEBUG_UI=false

# Internal admin dashboard secret path (must start with /, no trailing slash)
VITE_ADMIN_PATH=/_internal-admin-change-me

VITE_SCHOOL_URL=https://ai-language-school.online/
