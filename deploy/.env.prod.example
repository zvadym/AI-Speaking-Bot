# n8n workflow credential IDs for production
# Fill these with credential IDs from the prod n8n instance
# If you use multi-bot mode (deploy/bots/*.json), Telegram credential IDs are
# stored per-bot in those configs, so N8N_CRED_TELEGRAM_ID can be left empty.
N8N_CRED_OPENAI_ID=
N8N_CRED_POSTGRES_ID=
