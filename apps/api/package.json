{
  "name": "languagebot-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.js",
    "worker:dev": "tsx src/worker.js",
    "start": "node --import ./dist/instrument-api.js dist/server.js",
    "worker": "node --import ./dist/instrument-worker.js dist/worker.js",
    "test": "tsx --test"
  },
  "dependencies": {
    "@sentry/node": "^10.43.0",
    "@sentry/profiling-node": "^10.43.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.104.0",
    "pg": "^8.12.0",
    "pg-boss": "^12.14.0",
    "stripe": "^14.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
